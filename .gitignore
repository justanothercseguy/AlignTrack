# ==========================================
# AlignTrack - Git Ignore Configuration
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production & Build outputs
dist/
*/dist/
build/
*/build/
out/
.next/
*.tsbuildinfo

# Local Database & User Uploads (Personal treatment records & photos)
server/data/db.json
server/uploads/
uploads/
*.sqlite
*.sqlite3
*.db

# Logs & runtime data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# Operating System & IDE files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editor directories and files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Temporary directories
.temp/
.tmp/
tmp/
temp/
